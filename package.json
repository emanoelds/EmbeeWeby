{
  "name": "embeewebi",
  "version": "0.6.4",
  "private": true,
  "description": "Seu universo. Sua navegação.",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "check": "node --check main.cjs && node --check preload.cjs && node --check renderer.js && node --check cloud.cjs && node --check updates.cjs && node --check account-ui.js && node --check themes.js && node --check suggestions.cjs && node --check search-ui.js && node --check address-ui.js && node --check theme-gallery.js && node --check navigation-ui.js && node --check context-menus.cjs && node --check tools-ui.js && node --check browser-tools.cjs && node --check data-transfer.cjs && node --check google-auth.cjs && node --check transfer-ui.js",
    "dist": "electron-builder",
    "publish:windows": "electron-builder --win --publish always"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.embeewebi.browser",
    "productName": "EmbeeWebi",
    "files": [
      "main.cjs",
      "preload.cjs",
      "renderer.js",
      "index.html",
      "style.css",
      "assets/**/*",
      "cloud.cjs",
      "cloud-config.json",
      "updates.cjs",
      "release-config.json",
      "account-ui.js",
      "themes.js",
      "suggestions.cjs",
      "search-ui.js",
      "address-ui.js",
      "theme-gallery.js",
      "navigation-ui.js",
      "context-menus.cjs",
      "tools-ui.js",
      "browser-tools.cjs",
      "data-transfer.cjs",
      "google-auth.cjs",
      "transfer-ui.js"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/app-icon.ico",
      "signExecutable": false,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/app-icon.png"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/app-icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "emanoelds",
        "repo": "EmbeeWebi",
        "private": true,
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "electron-updater": "6.8.9",
    "js-yaml": "5.5.0",
    "qrcode": "1.5.4"
  }
}
